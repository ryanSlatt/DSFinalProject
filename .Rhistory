#Future date:
#Yahoo finance appears to have some other data, like quarterly market cap
#https://finance.yahoo.com/quote/AMD/key-statistics/
#It's also a little paywalled
#Could do it manually, could maybe get a little web scrapey
### Data Cleaning / Prep for DiD ###
semiData = semiData %>% select(symbol, date, adjusted)
dowJones = dowJones %>% select(symbol, date, adjusted)
nasdaq = nasdaq %>% select(symbol, date, adjusted)
#Calculating a percent change - we aren't interested in stock price in dollars, but relative performance
semiData = semiData %>% mutate(pct_change = (adjusted - lag(adjusted))/lag(adjusted)*100)
dowJones = dowJones %>% mutate(pct_change = (adjusted - lag(adjusted))/lag(adjusted)*100)
nasdaq = nasdaq %>% mutate(pct_change = (adjusted - lag(adjusted))/lag(adjusted)*100)
###Constructing variables for DiD
#Treated Group
semiData = semiData %>% mutate(treatedGroup = 1)
dowJones = dowJones %>% mutate(treatedGroup = 0)
nasdaq = nasdaq %>% mutate(treatedGroup = 0)
#AfterCutoff
semiData = semiData %>% mutate(afterCutoff = case_when(date<cutoffDate ~ 0,
date >= cutoffDate ~ 1))
dowJones = dowJones %>% mutate(afterCutoff = case_when(date<cutoffDate ~ 0,
date >= cutoffDate ~ 1))
nasdaq = nasdaq %>% mutate(afterCutoff = case_when(date<cutoffDate ~ 0,
date >= cutoffDate ~ 1))
#############################################
### SINGLE TREATMENT VARIABLE - Going instead for Treated Group, After, TreatedGroup x After to better see group and time effects
# #Adding the "treatment" variable
# # Should be 1 for semiconductor stocks after the passage of CHIPS Act, 0 for all else
# semiData = semiData %>% mutate(treated = case_when(date<cutoffDate ~ 0,
#                                            date >= cutoffDate ~ 1))
# dowJones = dowJones %>% mutate(treated = 0)
# nasdaq = nasdaq %>% mutate(treated = 0)
##############################################
#Combining into one dataset for DiD
#fullData = rbind(semiData,dowJones)
fullData = rbind(semiData,nasdaq)
### Basic DiD Model ###
#Need to scale before doing the regression
#model = feols(fullData, adjusted ~ treatedGroup + afterCutoff + treatedGroup:afterCutoff)
# Using percent change as the outcome we get insignificant results. Perhaps too noisy
#model = feols(fullData, pct_change ~ treatedGroup + afterCutoff + treatedGroup:afterCutoff)
#model
#Regression with scaled prices - should we scale by individual company or group? Either way pretty good results
fullData = fullData %>% group_by(symbol) %>% mutate(scaled_price = scale(adjusted))
model = feols(fullData, scaled_price ~ treatedGroup + afterCutoff + treatedGroup:afterCutoff)
model
# fullData = fullData %>% group_by(treatedGroup) %>% mutate(scaled_price = scale(adjusted))
# model = feols(fullData, scaled_price ~ treatedGroup + afterCutoff + treatedGroup:afterCutoff)
# model
#This is the naive model with no fixed effects - shouldn't do it this way
#feols(fullData, adjusted ~ treatedGroup:afterCutoff)
### Plot for Checking Parallel Trends Assumption ###
# NOTE: Currently we are just averaging percent change. Perhaps it would be best to weight by market cap
# NOTE: Generative AI used to aid in constructing these plots. 2/7/2026
library(dplyr)
library(ggplot2)
plot_data <- fullData %>%
filter(!is.na(adjusted)) %>%             # remove first NA returns
group_by(date, treatedGroup) %>%
summarise(
mean_price = mean(adjusted, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(group = if_else(treatedGroup == 1, "Treated", "Control"))
plot_data = plot_data %>% group_by(treatedGroup) %>% mutate(pct_change = (mean_price - lag(mean_price))/lag(mean_price)*100)
#A basic plot of stock price - not helpful at all due to scale issues
ggplot(plot_data, aes(x = date, y = mean_price, color = group)) +
geom_line(size = 1) +
geom_vline(xintercept = cutoffDate, linetype = "dashed") +  # replace cutoff
labs(
x = NULL,
y = "Average Stock Price",
color = NULL,
title = "Parallel Trends Check"
) +
theme_minimal()
#A scaled version of the previous plot
plot_data = plot_data %>% group_by(treatedGroup) %>% mutate(scaled_price = scale(mean_price))
ggplot(plot_data, aes(x = date, y = scaled_price, color = group)) +
geom_line(size = 1) +
geom_vline(xintercept = cutoffDate, linetype = "dashed") +  # replace cutoff
labs(
x = NULL,
y = "Scaled Average Stock Price",
color = NULL,
title = "Parallel Trends Check"
) +
theme_minimal()
# Plotting percent changes instead of raw price
ggplot(plot_data, aes(x = date, y = pct_change, color = group)) +
geom_line(size = 1) +
geom_vline(xintercept = cutoffDate, linetype = "dashed") +  # replace cutoff
labs(
x = NULL,
y = "% Change in Avg Stock Price",
color = NULL,
title = "Parallel Trends Check"
) +
theme_minimal()
#Some notes:
# Model coefficient is negative. Seems to suggest semi companies did WORSE than the NASDAQ
#Maybe the CHIPS act sparked a lot of speculative investing. People weren't super familiar
#with semiconductor companies or didn't like them for some reason (size, financials) so they just threw
#their money in the NASDAQ (it's all tech, right?)
#Or maybe the CHIPS act had an adverse effect on FOREIGN semi companies. Note there are export controls, etc. in there
#It will be interesting to see if any of this changes with controls. Maybe a control for foreign/domestic companies?
#List of companies that overlap between NASDAQ and my semi list?
#The ticker I started with is all companies listed on the NASDAQ. Probably significant overlap. Try a switch to the NASDAQ 100
#Upon switching to the NASDAQ 100, looks like similar results
#This may help determine if there is overlap:
#https://github.com/jmccarrell/n100tickers
#Got a list of those tickers using that package and a python script. Importing here to check
NasdaqTickerList <- read_csv("CSC493/NasdaqTickerList.csv")
NasdaqTickerList = NasdaqTickerList$`0`
#Want to make sure we only check against tickers used - remember some were removed for not being in the date range
tickersInUse = unique(semiData$symbol)
#59/70 of our semi tickers are NOT in the NASDAQ 100
setdiff(tickersInUse,NasdaqTickerList)
#Here are the 11 that are in the NASDAQ 100
intersect(tickersInUse,NasdaqTickerList)
